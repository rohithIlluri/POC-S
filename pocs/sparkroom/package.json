{
  "name": "sparkroom",
  "version": "0.1.0",
  "private": true,
  "description": "A room where humans talk and an AI collaborator is a peer, turning conversation into a shared, attributed draft",
  "keywords": [
    "multiplayer-ai",
    "collaboration",
    "react",
    "artifact",
    "poc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rohithIlluri/POC-S.git",
    "directory": "pocs/sparkroom"
  },
  "bugs": {
    "url": "https://github.com/rohithIlluri/POC-S/issues"
  },
  "license": "MIT",
  "main": "app/sparkroom.jsx",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "esbuild tests/entry.jsx --bundle --format=cjs --jsx=automatic --platform=node --outfile=tests/bundle.cjs",
    "pretest": "npm run build",
    "test": "node tests/harness.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
